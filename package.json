{
  "name": "point-view",
  "private": true,
  "version": "0.1.6",
  "author": "观曜科技",
  "type": "module",
  "description": "FAST-LIVO2 跨平台彩色点云采集、编辑与导出工作台",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:handheld": "vite --host 0.0.0.0 --open /handheld.html",
    "dev:omni": "vite --config vite.omni.config.ts --open /lab.html",
    "dev:omni:app": "vite --config vite.omni.config.ts",
    "build:omni": "tsc --noEmit -p tsconfig.omni.json && vite build --config vite.omni.config.ts",
    "build:omni:app": "tsc --noEmit -p tsconfig.omni.json && vite build --config vite.omni.config.ts --mode android",
    "preview:omni": "vite preview --config vite.omni.config.ts --host 127.0.0.1 --port 4174 --strictPort --open /lab.html",
    "pack:handheld": "node scripts/package-handheld-demo.mjs",
    "build": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run --pool=forks --poolOptions.forks.singleFork=true",
    "test:e2e": "npm run build && PLAYWRIGHT_BROWSERS_PATH=.tools/playwright playwright test",
    "test:watch": "vitest",
    "electron:dev": "npm run build && electron .",
    "electron:pack": "npm run build && electron-builder --dir",
    "electron:dist": "npm run build && electron-builder",
    "electron:dist:win": "npm run build && electron-builder --win --x64 --publish never -c.directories.output=release/windows-x64-direct",
    "android:add": "cap add android",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/core": "8.5.0",
    "@capacitor/filesystem": "8.1.2",
    "@foxglove/rosmsg": "5.0.5",
    "@foxglove/rosmsg-serialization": "2.1.2",
    "@foxglove/rosmsg2-serialization": "3.1.2",
    "@foxglove/ws-protocol": "0.8.0",
    "@loaders.gl/core": "^4.4.4",
    "@loaders.gl/las": "^4.4.4",
    "@mcap/core": "2.2.1",
    "fflate": "0.8.2",
    "idb-keyval": "6.2.2",
    "laz-perf": "^0.0.6",
    "lucide-react": "0.536.0",
    "leaflet": "1.9.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.0",
    "@capacitor/cli": "8.5.0",
    "@playwright/test": "1.62.1",
    "@types/node": "24.1.0",
    "@types/leaflet": "1.9.20",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "@types/three": "0.178.1",
    "@vitejs/plugin-react": "4.7.0",
    "electron": "43.2.0",
    "electron-builder": "26.0.12",
    "typescript": "5.8.3",
    "vite": "6.2.7",
    "vitest": "3.2.4"
  },
  "build": {
    "appId": "com.zk.pointview",
    "productName": "Point View",
    "asarUnpack": ["electron/object-studio/*.py"],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon-512x512.png",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "build/icon-512x512.png",
      "extraFiles": [
        { "from": "build/windows/使用说明.txt", "to": "使用说明.txt" }
      ],
      "extraResources": [
        { "from": ".tools/windows-object-runtime", "to": ".tools/object-runtime", "filter": ["**/*", "!**/__pycache__/**", "!**/*.pyc"] }
      ],
      "target": [
        "nsis",
        "zip"
      ]
    },
    "linux": {
      "extraResources": [
        { "from": ".tools/appimage-object-runtime", "to": ".tools/object-runtime", "filter": ["**/*", "!**/__pycache__/**", "!**/*.pyc"] }
      ],
      "category": "Graphics",
      "icon": "build/icon-512x512.png",
      "target": [
        "AppImage"
      ]
    }
  }
}
