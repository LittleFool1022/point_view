{
  "name": "point-view-survey-studio",
  "productName": "Point View Survey Studio",
  "version": "0.10.4",
  "private": true,
  "type": "module",
  "description": "观曜空间数据工作室 Windows 测量成果与 CAD 工程基座",
  "author": "观曜科技",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4186 --strictPort",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4186 --strictPort",
    "desktop": "npm run build && electron .",
    "pack:win": "npm run build && electron-builder --win --x64 --publish never",
    "test": "vitest run --config vitest.config.ts",
    "test:ui": "playwright test --config playwright.config.ts",
    "measure:baseline": "vite-node scripts/measure-baseline.ts",
    "diagnose:room-closure": "vite-node scripts/diagnose-room-closure.ts",
    "replay:room-faces": "vite-node scripts/replay-room-faces.ts",
    "survey:series-gaps": "vite-node scripts/survey-series-gaps.ts"
  },
  "devDependencies": {
    "@loaders.gl/core": "4.4.4",
    "@loaders.gl/las": "4.4.4",
    "@playwright/test": "1.62.1",
    "@types/node": "24.1.0",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "@types/three": "0.178.1",
    "@vitejs/plugin-react": "4.7.0",
    "electron": "43.2.0",
    "electron-builder": "26.0.12",
    "fflate": "0.8.2",
    "laz-perf": "0.0.6",
    "lucide-react": "0.536.0",
    "onnxruntime-web": "1.31.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1",
    "typescript": "5.8.3",
    "vite": "6.2.7",
    "vitest": "3.2.4"
  },
  "build": {
    "appId": "com.guanyao.surveystudio",
    "productName": "Point View Survey Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "pdf-lib": "1.17.1",
    "web-ifc": "0.0.78"
  }
}
